{
  "name": "skillloop",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:m3-studio": "node scripts/m3-studio-server.cjs",
    "test": "node scripts/check.cjs",
    "test:learning-path": "node --test learning-path/*.test.cjs tests/learning-path-ai.test.mjs tests/learning-path-api.test.mjs",
    "dev:interview": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "test:interview": "node --test interview/*.test.cjs"
  },
  "dependencies": {
    "ai": "7.0.151",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "playwright-core": "1.65.1"
  }
}
