# Server only. Copy to an ignored .env.local or configure the Vercel environment.

# Shared client for the new four-part workflow: server/ai.mjs
# Copy the OpenAI-compatible base URL and model ID from your provider console.
# AI_BASE_URL ends in /v1, not /chat/completions. Use a key from the same region.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# For Bailian models supporting this option, use false for non-thinking requests.
# Leave unset for providers that do not support the option.
# AI_ENABLE_THINKING=false
# Existing module configurations below remain active until their owners migrate.

# Knowledge accounts, graphs and publishing
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Knowledge teacher source discovery
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# Shared AI Gateway defaults; Vercel can use its deployment OIDC token.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Optional per-module model overrides; otherwise AI_GATEWAY_MODEL is used.
INTERVIEW_AI_MODEL=
CORRECTION_AI_MODEL=

# Correction teacher drafting; OpenRouter is an alternative to AI Gateway.
CORRECTION_TEACHER_CODE=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
