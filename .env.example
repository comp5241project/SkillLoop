# Copy variable names to the ignored .env.local file for local development.
# Configure the same server-only secrets in Vercel Preview before deploying.
# Never put real keys in this example file or commit .env.local.

# Existing Supabase project: public URL and browser-safe publishable key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Knowledge v0.4 server-side writes: use the service_role key for the SAME
# Supabase project as SUPABASE_URL. This is different from the publishable key
# and the Supabase Management API access token. Never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API token is only for applying/checking migrations.
# The running app does not use it. Keep it local and never deploy it to Vercel.
# SUPABASE_ACCESS_TOKEN=

# Knowledge v0.4 AI: OpenRouter provider. Fill these in .env.local and Vercel
# Preview. Use the full OpenRouter model ID, including its provider prefix,
# for example deepseek/deepseek-v4.1-flash.
OPENROUTER_API_KEY=
KNOWLEDGE_V4_OPENROUTER_MODEL=

# Set to 1 to exercise the Vercel queue path outside a Vercel runtime.
# KNOWLEDGE_V4_USE_QUEUE=1

# Legacy Knowledge teacher source discovery uses OpenAI until migrated.
# Leave empty if that legacy feature is not being exercised.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# Shared AI Gateway defaults; Vercel can use its deployment OIDC token.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Optional per-module model overrides; otherwise AI_GATEWAY_MODEL is used.
INTERVIEW_AI_MODEL=
CORRECTION_AI_MODEL=

# Correction teacher drafting can also use OpenRouter.
CORRECTION_TEACHER_CODE=
OPENROUTER_MODEL=
